# ============================================================
# ALUMGLASS - .gitignore global del monorepo
# Cubre: Python/Django (backend), Node/Next.js (frontend),
# entornos virtuales, variables de entorno, logs y SO/IDE.
# ============================================================

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------
# Entornos virtuales de Python
# ------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
__pypackages__/

# ------------------------------------------------------------
# Django
# ------------------------------------------------------------
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
*.sqlite3
*.sqlite3-journal
/backend/media/
/backend/staticfiles/
/backend/static/
/backend/.env

# Migraciones: NO se ignoran (deben versionarse)
# **/migrations/*.pyc ya queda cubierto por *.py[cod]

# ------------------------------------------------------------
# Testing / calidad Python
# ------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
*.cover
.hypothesis/
.ipynb_checkpoints/
cython_debug/

# ------------------------------------------------------------
# Node.js / dependencias
# ------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
.yarn-integrity

# ------------------------------------------------------------
# Next.js
# ------------------------------------------------------------
/frontend/.next/
/frontend/out/
/frontend/build/
/frontend/.turbo/
/frontend/.vercel
/frontend/next-env.d.ts
/frontend/.next-env.d.ts
/frontend/.swc/
*.tsbuildinfo

# ------------------------------------------------------------
# Testing / cobertura JavaScript
# ------------------------------------------------------------
/frontend/coverage/
.nyc_output/

# ------------------------------------------------------------
# Variables de entorno
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ------------------------------------------------------------
# Logs generales
# ------------------------------------------------------------
logs/
*.pid
*.seed

# ------------------------------------------------------------
# Sistema operativo
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ------------------------------------------------------------
# IDEs y editores
# ------------------------------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/

# ------------------------------------------------------------
# Otros
# ------------------------------------------------------------
*.bak
*.tmp
*.orig
tmp/
temp/
